@{
    Layout = "_ManagerLayout";
   // ViewData["Title"] = "User";
}
@model List<Todo_Application.Models.UserViewModel>

<h2>Users</h2>

<a asp-action="Add" class="btn btn-primary">Add New User</a>

<form asp-action="Index" method="get" class="row mb-3 mt-3">
    <div class="col-md-6">
        <input type="text" name="searchString" value="@ViewBag.Pagination?.SearchString" class="form-control" placeholder="Search by email.."/>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].UserName)</th>
            <th>@Html.DisplayNameFor(m=>m[0].Role)</th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table">
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Role</td>
                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model="ViewBag.Pagination" />