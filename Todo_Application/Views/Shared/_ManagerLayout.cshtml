


@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Todo_Application</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Todo_Application.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css"/>
</head>
<body>
    <div class="d-flex flex-column vh-100">

        <!-- TOP NAVBAR -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Todo_Application</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <!-- BOTTOM ROW: SIDEBAR + CONTENT -->
        <div class="d-flex flex-grow-1 overflow-hidden">

            <!-- SIDEBAR -->
            <div class="bg-dark text-white p-3 overflow-auto" style="width: 250px; flex-shrink: 0;">
                <h4 class="border-bottom pb-2">Options</h4>

                <div class="list-group list-group-flush">
                    <a asp-controller="Todoes" asp-action="Index"
                       class="list-group-item list-group-item-action border-0 @(currentController == "Todoes" ? "bg-white text-dark fw-bold" : "bg-dark text-white")">
                        View Todos
                    </a>

                    <a asp-controller="Roles" asp-action="Index"
                       class="list-group-item list-group-item-action border-0 @(currentController == "Roles" ? "bg-white text-dark fw-bold" : "bg-dark text-white")">
                        Manage Roles
                    </a>

                    <a asp-controller="Users" asp-action="Index"
                       class="list-group-item list-group-item-action border-0 @(currentController == "Users" ? "bg-white text-dark fw-bold" : "bg-dark text-white")">
                        Manage Users
                    </a>
                </div>

                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100">
                        &lt;&lt; Back to Home
                    </a>
                </div>
            </div>

            <!-- CONTENT -->
            <main class="flex-grow-1 overflow-auto p-4 bg-light">
                <h2>@ViewData["Title"]</h2>
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>